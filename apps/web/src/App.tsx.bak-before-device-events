  async function saveEmployeeEdit(e: React.FormEvent) {
    e.preventDefault();
    if (!editingEmployee) return;
    setNotice('');
    setError('');

    try {
      await api(`/employees/${encodeURIComponent(editingEmployee.id)}`, {
        method: 'PATCH',
        body: JSON.stringify(employeeForm)
      });
      setNotice('Trabajador actualizado correctamente.');
      setEditingEmployee(null);
      setEmployeeForm({rut:'',firstName:'',lastName:'',position:''});
      await load();
