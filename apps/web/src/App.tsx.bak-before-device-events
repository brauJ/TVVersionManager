    const name = window.prompt('Nombre de la sucursal:', b.name);
    if (name === null) return;
    if (name.trim().length < 2) {
      setError('El nombre de la sucursal debe tener al menos 2 caracteres.');
      return;
    }
    const address = window.prompt('Dirección de la sucursal (dejar vacío si no corresponde):', b.address || '');
    if (address === null) return;
    setError('');
    setNotice('');
    try {
      await api(`/branches/${encodeURIComponent(b.id)}`, {
        method:'PATCH',
        body:JSON.stringify({name:name.trim(), address:address.trim() || null})
      });
      setNotice('Sucursal actualizada.');
      await loadOrganization();
    } catch (err:any) {
      setError(`No se pudo actualizar la sucursal. ${err.message || ''}`);
    }
  }

  async function toggleBranch(b:Branch) {
    const active = !b.active;
    const message = active
      ? `¿Reactivar la sucursal "${b.name}"?`
      : `¿Desactivar la sucursal "${b.name}"? Los trabajadores e historiales se conservarán.`;
    if (!window.confirm(message)) return;
    setError('');
    setNotice('');
    try {
      await api(`/branches/${encodeURIComponent(b.id)}/status`, {
        method:'PATCH',
        body:JSON.stringify({active})
      });
      setNotice(active ? 'Sucursal reactivada.' : 'Sucursal desactivada.');
      await loadOrganization();
