    if (!window.confirm(message)) return;
    setError('');
    setNotice('');
    try {
      await api(`/departments/${encodeURIComponent(d.id)}/status`, {
        method:'PATCH',
        body:JSON.stringify({active})
      });
      setNotice(active ? 'Departamento reactivado.' : 'Departamento desactivado.');
      await loadOrganization();
