  async function toggleEmployeeStatus(employee: Employee) {
    const activating = employee.status !== 'ACTIVE';
    const action = activating ? 'reactivar' : 'desactivar';

    if (!window.confirm(
      `¿Deseas ${action} a ${employee.firstName} ${employee.lastName}?\n\nSu historial de asistencia se conservará.`
    )) return;

    setError('');
    setNotice('');

    try {
      await api(
        `/employees/${encodeURIComponent(employee.id)}/${activating ? 'activate' : 'deactivate'}`,
        { method: 'POST' }
      );
      setNotice(`Trabajador ${activating ? 'reactivado' : 'desactivado'} correctamente.`);
      await load();
    } catch (err: any) {
      setError(`No se pudo ${action} al trabajador. ${err.message || ''}`);
    }
  }

  const filteredRecords = useMemo(() => records.filter(record => {
    if (attendanceStatus !== 'ALL' && record.status !== attendanceStatus) return false;
    if (attendanceEmployee !== 'ALL' && record.employee?.id !== attendanceEmployee) return false;

    const timestamp = new Date(record.occurredAt).getTime();
    if (attendanceFrom) {
      const start = new Date(`${attendanceFrom}T00:00:00`).getTime();
      if (timestamp < start) return false;
    }
    if (attendanceTo) {
      const end = new Date(`${attendanceTo}T23:59:59.999`).getTime();
      if (timestamp > end) return false;
    }
    return true;
  }), [records, attendanceStatus, attendanceEmployee, attendanceFrom, attendanceTo]);

  async function reviewAttendance(record: RecordRow, status: 'CONFIRMED'|'VOIDED') {
    if (record.status !== 'PENDING_REVIEW') {
      setError('Solo se pueden revisar marcaciones pendientes.');
      return;
    }

    const action = status === 'CONFIRMED' ? 'confirmar' : 'anular';
    const reason = window.prompt(
      `Motivo obligatorio para ${action} la marcación de ${record.employee?.firstName || ''} ${record.employee?.lastName || ''}. Escribe al menos 8 caracteres:`
    );
    if (reason === null) return;
    if (reason.trim().length < 8) {
      setError('El motivo debe tener al menos 8 caracteres.');
      return;
    }

    if (status === 'VOIDED' && !window.confirm('¿Confirmas la anulación? Esta acción quedará registrada en la auditoría.')) return;

    setReviewBusy(record.id);
    setError('');
    setNotice('');
    try {
      await api(`/attendance/${encodeURIComponent(record.id)}/review`, {
        method: 'PATCH',
        body: JSON.stringify({ status, reason: reason.trim() })
      });
      setNotice(`Marcación ${status === 'CONFIRMED' ? 'confirmada' : 'anulada'} correctamente.`);
      await load();
    } catch (err:any) {
      setError(`No se pudo ${action} la marcación. ${err.message || ''}`);
    } finally {
      setReviewBusy('');
    }
  }

  function logout() { localStorage.removeItem('attendance_token'); setToken(''); setEmployees([]); setRecords([]); }

  if (!token) return <main className="login-shell"><section className="login-card"><div className="brand-mark"><Fingerprint size={28}/></div><p className="eyebrow">CONTROL LABORAL</p><h1>Asistencia</h1><p className="muted">Acceso al panel administrativo</p><form onSubmit={login} className="stack"><label>Correo electrónico<input type="email" value={email} onChange={e=>setEmail(e.target.value)} required autoComplete="username"/></label><label>Contraseña<input type="password" value={password} onChange={e=>setPassword(e.target.value)} required minLength={12} autoComplete="current-password"/></label>{error&&<p className="error">{error}</p>}<button className="primary"><LogIn size={17}/> Iniciar sesión</button></form><p className="footnote">Conecta la API y configura tu administrador mediante el seed de Prisma.</p></section></main>;

  return <div className="app-shell">
    <aside className="sidebar"><div className="brand"><div className="brand-mark"><Fingerprint size={23}/></div><div><strong>Asistencia</strong><small>GESTIÓN LABORAL</small></div></div><div className="nav-label">MENÚ PRINCIPAL</div>
      <button className={tab==='overview'?'nav active':'nav'} onClick={()=>setTab('overview')}><LayoutDashboard size={18}/> Resumen</button>
      <button className={tab==='employees'?'nav active':'nav'} onClick={()=>setTab('employees')}><Users size={18}/> Trabajadores</button>
      <button className={tab==='attendance'?'nav active':'nav'} onClick={()=>setTab('attendance')}><CalendarClock size={18}/> Marcaciones</button>
      <button className={tab==='users'?'nav active':'nav'} onClick={()=>setTab('users')}><Users size={18}/> Usuarios</button>
      <button className={tab==='organization'?'nav active':'nav'} onClick={()=>setTab('organization')}><LayoutDashboard size={18}/> Organización</button>
      <button className={tab==='shifts'?'nav active':'nav'} onClick={()=>setTab('shifts')}><Clock3 size={18}/> Turnos</button>
      <div className="sidebar-bottom"><div className="secure-note"><ShieldCheck size={18}/><span><b>Panel protegido</b><small>Revisa los permisos del servidor antes de producción.</small></span></div><button className="nav" onClick={logout}><LogOut size={18}/> Cerrar sesión</button></div>
    </aside>
    <main className="main">
      <header className="topbar"><div><p className="eyebrow">SISTEMA DE ASISTENCIA</p><h1>{tab==='overview'?'Resumen general':tab==='employees'?'Trabajadores':tab==='attendance'?'Marcaciones':tab==='users'?'Usuarios':tab==='organization'?'Organización':'Turnos'}</h1></div><div className="top-actions"><span className="server-pill"><span className="dot"/> API conectada</span><button className="icon-button" onClick={()=>{
        if(tab==='users') void loadUsers();
        else if(tab==='organization') void loadOrganization();
        else if(tab==='shifts') void loadShifts();
        else void load();
      }} title="Actualizar"><RefreshCw size={17}/></button></div></header>
      {error&&<div className="alert error">{error}</div>}{notice&&<div className="alert">{notice}</div>}
      {tab==='overview'&&<><section className="welcome"><div><p className="eyebrow light">PANEL DE CONTROL</p><h2>Todo en orden, a primera vista.</h2><p>Consulta la actividad de asistencia y administra la información de tu equipo.</p></div><div className="welcome-icon"><Activity size={38}/></div></section>
        <section className="stat-grid"><Stat icon={<Users/>} label="Trabajadores cargados" value={String(employees.length)} hint="Registros disponibles"/><Stat icon={<Clock3/>} label="Marcaciones de hoy" value={String(todayCount)} hint="Según hora local del navegador"/><Stat icon={<BadgeCheck/>} label="Últimos registros" value={String(records.length)} hint="Máximo 1.000 registros consultados"/></section>
        <section className="panel"><div className="panel-head"><div><h3>Marcaciones recientes</h3><p>Eventos recibidos desde la base de datos</p></div><button className="secondary" onClick={()=>setTab('attendance')}>Ver marcaciones</button></div><Records rows={records.slice(0,8)}/></section></>}
      {tab==='employees'&&<><section className="panel"><div className="panel-head"><div><h3>Directorio de trabajadores</h3><p>Consulta trabajadores guardados en MySQL</p></div><form className="search" onSubmit={e=>{e.preventDefault();void load();}}><Search size={17}/><input placeholder="Buscar nombre o RUT" value={query} onChange={e=>setQuery(e.target.value)}/><select aria-label="Filtrar por estado" value={employeeStatusFilter} onChange={e=>setEmployeeStatusFilter(e.target.value)}><option value="ALL">Todos</option><option value="ACTIVE">Activos</option><option value="INACTIVE">Inactivos</option></select><button className="secondary">Buscar</button></form></div><div className="table-wrap"><table><thead><tr><th>Trabajador</th><th>RUT</th><th>Cargo</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>{employees.map(e=><tr key={e.id}><td><b>{e.firstName} {e.lastName}</b></td><td>{e.rut}</td><td>{e.position||'—'}</td><td><span className="status">{e.status==='ACTIVE'?'Activo':'Inactivo'}</span></td><td><div className="action-buttons"><button type="button" className="secondary" onClick={()=>startEmployeeEdit(e)}>Editar</button><button type="button" className="secondary" onClick={()=>void toggleEmployeeStatus(e)}>{e.status==='ACTIVE'?'Desactivar':'Reactivar'}</button></div></td></tr>)}</tbody></table>{!employees.length&&<div className="empty">No hay trabajadores para mostrar.</div>}</div></section>
        <section className="panel"><div className="panel-head"><div><h3>{editingEmployee ? 'Editar trabajador' : 'Agregar trabajador'}</h3><p>{editingEmployee ? 'Modifica los datos del trabajador seleccionado' : 'Los datos se guardarán en la base de datos'}</p></div></div><form className="employee-form" onSubmit={editingEmployee ? saveEmployeeEdit : createEmployee}><label>RUT<input value={employeeForm.rut} onChange={e=>setEmployeeForm({...employeeForm,rut:e.target.value})} required minLength={3}/></label><label>Nombre<input value={employeeForm.firstName} onChange={e=>setEmployeeForm({...employeeForm,firstName:e.target.value})} required/></label><label>Apellidos<input value={employeeForm.lastName} onChange={e=>setEmployeeForm({...employeeForm,lastName:e.target.value})} required/></label><label>Cargo<input value={employeeForm.position} onChange={e=>setEmployeeForm({...employeeForm,position:e.target.value})}/></label><div className="action-buttons"><button className="primary" type="submit">{editingEmployee ? 'Guardar cambios' : 'Guardar trabajador'}</button>{editingEmployee && <button className="secondary" type="button" onClick={()=>{setEditingEmployee(null);setEmployeeForm({rut:'',firstName:'',lastName:'',position:''});}}>Cancelar edición</button>}</div></form></section></>}
      {tab==='attendance'&&<section className="panel">
        <div className="panel-head">
          <div><h3>Historial y revisión de marcaciones</h3><p>Filtra los registros y revisa las marcaciones pendientes.</p></div>
          <button className="secondary" onClick={()=>downloadCsv(filteredRecords)}><Download size={16}/> Exportar filtrados ({filteredRecords.length})</button>
        </div>
        <div className="attendance-filters">
          <label>Desde<input type="date" value={attendanceFrom} onChange={e=>setAttendanceFrom(e.target.value)}/></label>
          <label>Hasta<input type="date" value={attendanceTo} min={attendanceFrom || undefined} onChange={e=>setAttendanceTo(e.target.value)}/></label>
          <label>Trabajador<select value={attendanceEmployee} onChange={e=>setAttendanceEmployee(e.target.value)}><option value="ALL">Todos los trabajadores</option>{employees.map(e=><option key={e.id} value={e.id}>{e.firstName} {e.lastName} · {e.rut}</option>)}</select></label>
          <label>Estado<select value={attendanceStatus} onChange={e=>setAttendanceStatus(e.target.value)}><option value="ALL">Todos los estados</option><option value="PENDING_REVIEW">Pendiente de revisión</option><option value="CONFIRMED">Confirmada</option><option value="VOIDED">Anulada</option></select></label>
          <button type="button" className="secondary" onClick={()=>{setAttendanceFrom('');setAttendanceTo('');setAttendanceStatus('ALL');setAttendanceEmployee('ALL');}}>Limpiar filtros</button>
        </div>
        <p className="filter-summary">Mostrando {filteredRecords.length} de {records.length} registros cargados. La API entrega como máximo 1.000 por consulta.</p>
        <Records rows={filteredRecords} onReview={reviewAttendance} reviewBusy={reviewBusy} showReason/>
      </section>}
      {tab==='users'&&<section className="panel">
        <div className="panel-head">
          <div>
            <h3>Administración de usuarios</h3>
            <p>Activa o desactiva cuentas y consulta sus permisos asignados.</p>
          </div>
          <button className="secondary" onClick={()=>void loadUsers()} disabled={!!userActionBusy}>
            <RefreshCw size={16}/> Actualizar
          </button>
        </div>
        <div className="table-wrap">
          <table>
            <thead>
              <tr><th>Usuario</th><th>Tipo</th><th>Permisos</th><th>Estado</th><th>Acción</th></tr>
            </thead>
            <tbody>
              {users.map(user=><tr key={user.id}>
                <td>
                  <b>{user.fullName}</b>
                  <small className="subcell">{user.email}</small>
                </td>
                <td>{user.isSuperAdmin?'Superadministrador':'Usuario'}</td>
                <td>{user.permissions?.length ? user.permissions.map(p=>p.code).join(', ') : user.isSuperAdmin?'Todos (superadministrador)':'Sin permisos asignados'}</td>
                <td>
                  <span className="status">{user.status==='ACTIVE'?'Activo':'Desactivado'}</span>
                </td>
                <td>
                  <button
                    type="button"
                    className="secondary"
                    disabled={!!userActionBusy}
                    onClick={()=>beginEditUser(user)}
                  >
                    Editar usuario
                  </button>
                  <button
                    className={user.status==='ACTIVE'?'secondary':'primary'}
                    disabled={!!userActionBusy}
                    onClick={()=>void toggleUserStatus(user)}
                  >
                    {userActionBusy===user.id?'Procesando…':user.status==='ACTIVE'?'Desactivar':'Activar'}
                  </button>
                  {!user.isSuperAdmin&&<button
                    type="button"
                    className="secondary"
                    disabled={!!userActionBusy}
                    onClick={()=>beginEditUserPermissions(user)}
                  >
                    Editar permisos
                  </button>}
                </td>
              </tr>)}
            </tbody>
          </table>
          {!users.length&&<div className="empty">No hay usuarios para mostrar o no se pudieron cargar.</div>}
        </div>

        {editingUser&&<div className="panel permission-editor">
          <div className="panel-head">
            <div>
              <h3>Editar usuario</h3>
              <p>Modifica el nombre y correo. La contraseña es opcional si solo deseas actualizar el perfil.</p>
            </div>
            <button
              type="button"
              className="secondary"
              disabled={!!userActionBusy}
              onClick={()=>{
                setEditingUser(null);
                setUserEditForm({fullName:'',email:'',password:'',confirmPassword:''});
              }}
            >
              Cancelar
            </button>
          </div>
          <form className="employee-form" onSubmit={saveUserEdit}>
            <label>
              Nombre completo
              <input
                value={userEditForm.fullName}
                onChange={e=>setUserEditForm({...userEditForm,fullName:e.target.value})}
                minLength={2}
                maxLength={120}
                autoComplete="name"
                required
                disabled={!!userActionBusy}
              />
            </label>
            <label>
              Correo electrónico
              <input
                type="email"
                value={userEditForm.email}
                onChange={e=>setUserEditForm({...userEditForm,email:e.target.value})}
                autoComplete="email"
                required
                disabled={!!userActionBusy}
              />
            </label>
            <label>
              Nueva contraseña
              <input
                type="password"
                value={userEditForm.password}
                onChange={e=>setUserEditForm({...userEditForm,password:e.target.value})}
                minLength={12}
                autoComplete="new-password"
                placeholder="Mínimo 12 caracteres; dejar vacío para no cambiar"
                disabled={!!userActionBusy}
              />
            </label>
            <label>
              Confirmar nueva contraseña
              <input
                type="password"
                value={userEditForm.confirmPassword}
                onChange={e=>setUserEditForm({...userEditForm,confirmPassword:e.target.value})}
                minLength={12}
                autoComplete="new-password"
                placeholder="Repite la nueva contraseña"
                disabled={!!userActionBusy}
              />
            </label>
            <div className="permission-footer">
              <span>La contraseña actual nunca se muestra.</span>
              <button type="submit" className="primary" disabled={!!userActionBusy}>
                {userActionBusy===editingUser.id?'Guardando…':'Guardar cambios'}
              </button>
            </div>
          </form>
        </div>}

        {editingPermissionsUser&&<div className="panel permission-editor">
          <div className="panel-head">
            <div>
              <h3>Permisos de {editingPermissionsUser.fullName}</h3>
              <p>Selecciona únicamente las acciones que esta cuenta necesita. Los cambios reemplazan su lista actual de permisos.</p>
            </div>
            <button type="button" className="secondary" onClick={()=>setEditingPermissionsUser(null)} disabled={!!userActionBusy}>Cancelar</button>
          </div>
          <div className="permission-grid">
            {permissionCatalog.map(permission=><label className="permission-option" key={permission.code}>
              <input
                type="checkbox"
                checked={selectedPermissionCodes.includes(permission.code)}
                disabled={!!userActionBusy}
                onChange={event=>setSelectedPermissionCodes(current=>
                  event.target.checked
                    ? [...current,permission.code]
                    : current.filter(code=>code!==permission.code)
                )}
              />
              <span><b>{permission.description}</b><small>{permission.code}</small></span>
            </label>)}
          </div>
          {!permissionCatalog.length&&<div className="empty">No se pudo cargar el catálogo de permisos. Pulsa Actualizar e inténtalo de nuevo.</div>}
          <div className="permission-footer">
            <span>{selectedPermissionCodes.length} permisos seleccionados</span>
            <button type="button" className="primary" onClick={()=>void saveUserPermissions()} disabled={!!userActionBusy||!permissionCatalog.length}>
              {userActionBusy===editingPermissionsUser.id?'Guardando…':'Guardar permisos'}
            </button>
          </div>
        </div>}
      </section>}
      {tab==='organization'&&<>
        <section className="stat-grid">
          <Stat icon={<Users/>} label="Departamentos" value={String(departments.length)} hint="Guardados en MySQL"/>
          <Stat icon={<LayoutDashboard/>} label="Sucursales" value={String(branches.length)} hint="Guardadas en MySQL"/>
        </section>
        <section className="panel">
          <div className="panel-head">
            <div><h3>Departamentos</h3><p>Organiza a los trabajadores por área.</p></div>
            <button className="secondary" onClick={()=>void loadOrganization()} disabled={organizationBusy}><RefreshCw size={16}/> Actualizar</button>
          </div>
          <form className="employee-form" onSubmit={createDepartment}>
            <label>Nombre del departamento
              <input value={departmentName} onChange={e=>setDepartmentName(e.target.value)} minLength={2} required placeholder="Ej. Administración"/>
            </label>
            <button className="primary" disabled={organizationBusy}>Crear departamento</button>
          </form>
          <div className="table-wrap">
            <table><thead><tr><th>Departamento</th><th>Estado</th><th>Trabajadores</th><th>Acciones</th></tr></thead>
              <tbody>{departments.map(d=><tr key={d.id}>
                <td><b>{d.name}</b></td>
                <td><span className="status">{d.active ? 'Activo' : 'Inactivo'}</span></td>
                <td>{d._count?.employees ?? 0}</td>
                <td><div className="action-buttons">
                  <button type="button" className="secondary" onClick={()=>void editDepartment(d)} disabled={organizationBusy}>Editar</button>
                  <button type="button" className="secondary" onClick={()=>void toggleDepartment(d)} disabled={organizationBusy}>{d.active ? 'Desactivar' : 'Reactivar'}</button>
                </div></td>
              </tr>)}</tbody>
            </table>
            {!departments.length&&<div className="empty">No hay departamentos registrados.</div>}
          </div>
        </section>
        <section className="panel">
          <div className="panel-head"><div><h3>Sucursales</h3><p>Registra las ubicaciones de la empresa.</p></div></div>
          <form className="employee-form" onSubmit={createBranch}>
            <label>Nombre de la sucursal
              <input value={branchForm.name} onChange={e=>setBranchForm({...branchForm,name:e.target.value})} minLength={2} required placeholder="Ej. Casa matriz"/>
            </label>
            <label>Dirección
              <input value={branchForm.address} onChange={e=>setBranchForm({...branchForm,address:e.target.value})} placeholder="Calle, número y comuna"/>
            </label>
            <button className="primary" disabled={organizationBusy}>Crear sucursal</button>
          </form>
          <div className="table-wrap">
            <table><thead><tr><th>Sucursal</th><th>Dirección</th><th>Estado</th><th>Trabajadores</th><th>Acciones</th></tr></thead>
              <tbody>{branches.map(b=><tr key={b.id}>
                <td><b>{b.name}</b></td>
                <td>{b.address||'—'}</td>
                <td><span className="status">{b.active ? 'Activo' : 'Inactivo'}</span></td>
                <td>{b._count?.employees ?? 0}</td>
                <td><div className="action-buttons">
                  <button type="button" className="secondary" onClick={()=>void editBranch(b)} disabled={organizationBusy}>Editar</button>
                  <button type="button" className="secondary" onClick={()=>void toggleBranch(b)} disabled={organizationBusy}>{b.active ? 'Desactivar' : 'Reactivar'}</button>
                </div></td>
              </tr>)}</tbody>
            </table>
            {!branches.length&&<div className="empty">No hay sucursales registradas.</div>}
          </div>
        </section>
      </>}

      {tab==='shifts'&&<>
        <section className="panel">
          <div className="panel-head">
            <div><h3>Crear turno</h3><p>Define los horarios y la modalidad de marcación.</p></div>
            <button className="secondary" onClick={()=>void loadShifts()} disabled={shiftBusy}><RefreshCw size={16}/> Actualizar</button>
          </div>
          <form className="employee-form" onSubmit={createShift}>
            <label>Nombre del turno
              <input value={shiftForm.name} onChange={e=>setShiftForm({...shiftForm,name:e.target.value})} minLength={2} required placeholder="Ej. Turno diurno"/>
            </label>
            <label>Hora de entrada
              <input type="time" value={shiftForm.startTime} onChange={e=>setShiftForm({...shiftForm,startTime:e.target.value})} required/>
            </label>
            <label>Hora de salida
              <input type="time" value={shiftForm.endTime} onChange={e=>setShiftForm({...shiftForm,endTime:e.target.value})} required/>
            </label>
            <label>Modalidad
              <select value={shiftForm.mode} onChange={e=>setShiftForm({...shiftForm,mode:e.target.value as 'TWO_PUNCH'|'FOUR_PUNCH'})}>
                <option value="FOUR_PUNCH">4 marcaciones (entrada, colación, regreso, salida)</option>
                <option value="TWO_PUNCH">2 marcaciones (entrada y salida)</option>
              </select>
            </label>
            {shiftForm.mode==='FOUR_PUNCH'&&<>
              <label>Inicio de colación
                <input type="time" value={shiftForm.breakStart} onChange={e=>setShiftForm({...shiftForm,breakStart:e.target.value})} required/>
              </label>
              <label>Fin de colación
                <input type="time" value={shiftForm.breakEnd} onChange={e=>setShiftForm({...shiftForm,breakEnd:e.target.value})} required/>
              </label>
            </>}
            <label>Tolerancia (minutos)
              <input type="number" min="0" step="1" value={shiftForm.toleranceMinutes} onChange={e=>setShiftForm({...shiftForm,toleranceMinutes:e.target.value})} required/>
            </label>
            <label>
              <span>El turno termina al día siguiente</span>
              <input type="checkbox" checked={shiftForm.crossesMidnight} onChange={e=>setShiftForm({...shiftForm,crossesMidnight:e.target.checked})}/>
            </label>
            <button className="primary" disabled={shiftBusy}>Guardar turno</button>
          </form>
        </section>

        <section className="panel">
          <div className="panel-head"><div><h3>Asignar turno</h3><p>Selecciona un trabajador y el período de vigencia.</p></div></div>
          <form className="employee-form" onSubmit={assignShift}>
            <label>Turno
              <select value={assignmentForm.shiftId} onChange={e=>setAssignmentForm({...assignmentForm,shiftId:e.target.value})} required>
                <option value="">Selecciona un turno</option>
                {shifts.filter(s=>s.active).map(s=><option key={s.id} value={s.id}>{s.name} ({s.startTime}–{s.endTime})</option>)}
              </select>
            </label>
            <label>Trabajador activo
              <select value={assignmentForm.employeeId} onChange={e=>setAssignmentForm({...assignmentForm,employeeId:e.target.value})} required>
                <option value="">Selecciona un trabajador</option>
                {employees.filter(e=>e.status==='ACTIVE').map(e=><option key={e.id} value={e.id}>{e.firstName} {e.lastName} — {e.rut}</option>)}
              </select>
            </label>
            <label>Válido desde
              <input type="date" value={assignmentForm.validFrom} onChange={e=>setAssignmentForm({...assignmentForm,validFrom:e.target.value})} required/>
            </label>
            <label>Válido hasta (opcional)
              <input type="date" min={assignmentForm.validFrom||undefined} value={assignmentForm.validTo} onChange={e=>setAssignmentForm({...assignmentForm,validTo:e.target.value})}/>
            </label>
            <button className="primary" disabled={shiftBusy||!shifts.some(s=>s.active)||!employees.some(e=>e.status==='ACTIVE')}>Asignar turno</button>
          </form>
          {(!shifts.some(s=>s.active)||!employees.some(e=>e.status==='ACTIVE'))&&<p className="muted">Para asignar, debe existir al menos un turno activo y un trabajador activo.</p>}
        </section>

        <section className="panel">
          <div className="panel-head"><div><h3>Turnos registrados</h3><p>Horarios y trabajadores asignados según los datos del servidor.</p></div>
            <button className="secondary" onClick={() => void loadShifts()} disabled={shiftBusy}><RefreshCw size={16}/> Actualizar</button>
          </div>
          <div className="table-wrap">
            <table><thead><tr><th>Turno</th><th>Horario</th><th>Colación</th><th>Modalidad</th><th>Tolerancia</th><th>Asignaciones</th></tr></thead>
              <tbody>{shifts.map(s=><tr key={s.id}>
                <td><b>{s.name}</b><small className="subcell">{s.active ? 'Activo' : 'Inactivo'} · {s.crossesMidnight?'Termina al día siguiente':'Mismo día'}</small></td>
                <td>{s.startTime}–{s.endTime}</td>
                <td>{s.breakStart&&s.breakEnd?`${s.breakStart}–${s.breakEnd}`:'No definida'}</td>
                <td>{s.mode==='TWO_PUNCH'?'2 marcaciones':'4 marcaciones'}</td>
                <td>{s.toleranceMinutes} min</td>
                <td>
                  {s.assignments?.length ?? 0}
                  <div className="shift-actions">
                    <button
                      className="secondary"
                      type="button"
                      onClick={() => void setShiftActive(s)}
                      disabled={shiftBusy}
                      title="Cambiar el estado sin borrar el historial"
                    >{s.active ? 'Desactivar turno' : 'Reactivar turno'}</button>
                  </div>
                </td>
              </tr>)}</tbody>
            </table>
            {!shifts.length&&<div className="empty">No hay turnos registrados.</div>}
          </div>
          {shifts.some(s=>(s.assignments?.length ?? 0)>0)&&<div className="table-wrap">
            <table><thead><tr><th>Turno</th><th>Trabajador</th><th>Desde</th><th>Hasta</th><th>Acciones</th></tr></thead>
              <tbody>{shifts.flatMap(s=>(s.assignments||[]).map(a=><tr key={a.id}>
                <td>{s.name}</td>
                <td>{a.employee.firstName} {a.employee.lastName} ({a.employee.rut})</td>
                <td>{new Date(a.validFrom).toLocaleDateString('es-CL')}</td>
                <td>{a.validTo?new Date(a.validTo).toLocaleDateString('es-CL'):'Sin fecha de término'}</td>
                <td>
                  {a.validTo
                    ? <span className="subcell">Vigencia finalizada</span>
                    : <button
                        className="secondary"
                        type="button"
                        onClick={() => void closeShiftAssignment(s,a)}
                        disabled={shiftBusy}
                      >Finalizar asignación</button>}
                </td>
              </tr>))}</tbody>
            </table>
          </div>}
        </section>
      </>}

      <footer>Asistencia · Base de desarrollo · Requiere revisión de seguridad y normativa antes de uso oficial.</footer>
    </main>
  </div>;
}
function Stat({icon,label,value,hint}:{icon:React.ReactNode,label:string,value:string,hint:string}) { return <div className="stat"><div className="stat-top"><span className="stat-icon">{icon}</span><span className="stat-hint">{hint}</span></div><p>{label}</p><strong>{value}</strong></div>; }
function Records({rows,onReview,reviewBusy='',showReason=false}:{rows:RecordRow[];onReview?:(record:RecordRow,status:'CONFIRMED'|'VOIDED')=>void;reviewBusy?:string;showReason?:boolean}) {
  const labels:any={ENTRY:'Entrada',BREAK_START:'Salida a colación',BREAK_END:'Regreso de colación',EXIT:'Salida final'};
  const methods:any={FINGERPRINT:'Huella',PIN:'PIN',ADMIN_MANUAL:'Manual'};
  const statuses:any={CONFIRMED:'Confirmada',PENDING_REVIEW:'Pendiente de revisión',VOIDED:'Anulada'};
  return <div className="table-wrap"><table><thead><tr><th>Trabajador</th><th>Tipo</th><th>Fecha y hora</th><th>Método</th><th>Estado</th>{showReason&&<><th>Motivo original</th><th>Creada por</th><th>Revisión y auditoría</th></>}{onReview&&<th>Acciones</th>}</tr></thead><tbody>{rows.map(r=><tr key={r.id}>
    <td><b>{r.employee?.firstName} {r.employee?.lastName}</b><small className="subcell">{r.employee?.rut}</small></td>
    <td>{labels[r.type]||r.type}</td><td>{fmt(r.occurredAt)}</td><td>{methods[r.method]||r.method}</td>
    <td><span className={`status ${r.status==='PENDING_REVIEW'?'status-pending':r.status==='VOIDED'?'status-voided':''}`}>{statuses[r.status]||r.status}</span></td>
    {showReason&&<>
      <td className="reason-cell">{r.manualReason||'—'}</td>
      <td className="reason-cell">
        {(() => {
          const createdEvent = r.auditTrail?.find(log => log.action === 'ATTENDANCE_MANUAL_CREATED');
          const creator = r.creator || createdEvent?.user;
          return <>
            <b>{creator?.fullName || 'No disponible'}</b>
            <small className="subcell">{creator?.email || 'Sin correo registrado'}</small>
            {createdEvent && <small className="subcell">Evento: {fmt(createdEvent.createdAt)}</small>}
          </>;
        })()}
      </td>
      <td className="reason-cell">
        {(() => {
          const reviewEvent = [...(r.auditTrail || [])].reverse().find(
            log => log.action === 'ATTENDANCE_REVIEW_CONFIRMED' ||
                   log.action === 'ATTENDANCE_REVIEW_VOIDED'
          );
          if (!reviewEvent) {
            return <span className="subcell">Sin revisión registrada</span>;
          }
          const confirmed = reviewEvent.action === 'ATTENDANCE_REVIEW_CONFIRMED';
          return <>
            <b>{confirmed ? 'Confirmada por' : 'Anulada por'}</b>
            <small className="subcell">{reviewEvent.user?.fullName || 'Usuario no disponible'}</small>
            <small className="subcell">{fmt(reviewEvent.createdAt)}</small>
            <small className="subcell">Motivo: {reviewEvent.reason || 'No registrado'}</small>
          </>;
        })()}
      </td>
    </>}
    {onReview&&<td>{r.status==='PENDING_REVIEW'?<div className="action-buttons"><button type="button" className="secondary" disabled={reviewBusy===r.id} onClick={()=>void onReview(r,'CONFIRMED')}>Confirmar</button><button type="button" className="danger-button" disabled={reviewBusy===r.id} onClick={()=>void onReview(r,'VOIDED')}>Anular</button></div>:<span className="subcell">Sin acciones</span>}</td>}
  </tr>)}</tbody></table>{!rows.length&&<div className="empty">No hay marcaciones para mostrar con estos filtros.</div>}</div>;
}
function downloadCsv(rows:RecordRow[]) { const lines=[['Trabajador','RUT','Tipo','Fecha','Método','Estado'],...rows.map(r=>[`${r.employee?.firstName||''} ${r.employee?.lastName||''}`,r.employee?.rut||'',r.type,r.occurredAt,r.method,r.status])]; const csv=lines.map(line=>line.map(x=>`"${String(x).replace(/"/g,'""')}"`).join(';')).join('\r\n'); const url=URL.createObjectURL(new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8;'})); const a=document.createElement('a'); a.href=url; a.download='marcaciones.csv'; a.click(); URL.revokeObjectURL(url); }
