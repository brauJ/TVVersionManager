  async function createShift(e:React.FormEvent) {
    e.preventDefault();
    setNotice('');
    setError('');
    try {
      const payload:any = {
        name:shiftForm.name.trim(),
        startTime:shiftForm.startTime,
        endTime:shiftForm.endTime,
        toleranceMinutes:Number(shiftForm.toleranceMinutes || 0),
        mode:shiftForm.mode,
        crossesMidnight:shiftForm.crossesMidnight
      };
      if (shiftForm.mode === 'FOUR_PUNCH') {
        payload.breakStart = shiftForm.breakStart;
        payload.breakEnd = shiftForm.breakEnd;
      }
      await api('/shifts', {
        method:'POST',
        body:JSON.stringify(payload)
      });
      setShiftForm(old => ({...old,name:''}));
      setNotice('Turno creado correctamente.');
      await loadShifts();
    } catch (err:any) {
      setError(`No se pudo crear el turno. ${err.message || ''}`);
    }
  }


  async function setShiftActive(shift: Shift) {
    const nextActive = !shift.active;
    const action = nextActive ? 'reactivar' : 'desactivar';

    const ok = window.confirm(
      `¿Deseas ${action} el turno "${shift.name}"?\\n\\n` +
      'El historial del turno y sus asignaciones se conservarán.'
    );
    if (!ok) return;

    setNotice('');
    setError('');
    try {
      await api(`/shifts/${encodeURIComponent(shift.id)}/status`, {
        method: 'PATCH',
        body: JSON.stringify({ active: nextActive })
      });
      setNotice(
        nextActive
          ? `Turno "${shift.name}" reactivado.`
          : `Turno "${shift.name}" desactivado.`
      );
      await loadShifts();
    } catch (err: any) {
      setError(`No se pudo cambiar el estado del turno. ${err.message || ''}`);
    }
  }

  async function closeShiftAssignment(
    shift: Shift,
    assignment: NonNullable<Shift['assignments']>[number]
  ) {
    const employeeName =
      `${assignment.employee.firstName} ${assignment.employee.lastName}`;

    const currentDate = new Date();
    const defaultDate = [
      currentDate.getFullYear(),
      String(currentDate.getMonth() + 1).padStart(2, '0'),
      String(currentDate.getDate()).padStart(2, '0')
    ].join('-');

    const validTo = window.prompt(
      `Fecha de término para ${employeeName} en el turno "${shift.name}" (AAAA-MM-DD):`,
      assignment.validTo
        ? assignment.validTo.slice(0, 10)
        : defaultDate
    );

    if (validTo === null) return;

    if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(validTo)) {
      setError('Introduce la fecha en formato AAAA-MM-DD.');
      return;
    }

    const parsedDate = new Date(`${validTo}T12:00:00`);
    if (
      Number.isNaN(parsedDate.getTime()) ||
      parsedDate.toISOString().slice(0, 10) !== validTo
    ) {
      setError('La fecha de término no es válida.');
      return;
    }

    setNotice('');
    setError('');
    try {
      await api(
        `/shifts/${encodeURIComponent(shift.id)}/assignments/${encodeURIComponent(assignment.id)}/close`,
        {
          method: 'POST',
          body: JSON.stringify({ validTo: `${validTo}T12:00:00.000Z` })
        }
      );
      setNotice(
        `Asignación de ${employeeName} actualizada. Se conserva su historial.`
      );
      await loadShifts();
    } catch (err: any) {
      setError(`No se pudo cerrar la asignación. ${err.message || ''}`);
    }
  }

  async function assignShift(e:React.FormEvent) {
    e.preventDefault();
    setNotice('');
    setError('');
    if (!assignmentForm.shiftId || !assignmentForm.employeeId || !assignmentForm.validFrom) {
      setError('Selecciona un turno, un trabajador y la fecha inicial.');
      return;
    }
    try {
      await api(`/shifts/${encodeURIComponent(assignmentForm.shiftId)}/assignments`, {
        method:'POST',
        body:JSON.stringify({
          employeeId:assignmentForm.employeeId,
          validFrom:assignmentForm.validFrom,
          ...(assignmentForm.validTo ? {validTo:assignmentForm.validTo} : {})
        })
      });
      setNotice('Turno asignado correctamente.');
      setAssignmentForm(old => ({...old,validTo:''}));
      await loadShifts();
    } catch (err:any) {
      setError(`No se pudo asignar el turno. ${err.message || ''}`);
    }
  }

  useEffect(()=>{
    if (!token) return;
    if (tab === 'users') void loadUsers();
    else if (tab === 'organization') void loadOrganization();
    else if (tab === 'shifts') void loadShifts();
    else void load();
  },[token,tab]);
  const todayCount = useMemo(()=>records.filter(r=>new Date(r.occurredAt).toDateString()===new Date().toDateString()).length,[records]);
  async function createEmployee(e:React.FormEvent) {
    e.preventDefault(); setNotice('');
    try {
      await api('/employees',{method:'POST',body:JSON.stringify(employeeForm)});
      setEmployeeForm({rut:'',firstName:'',lastName:'',position:''}); setNotice('Trabajador creado.'); await load();
    } catch(err:any) { setNotice(`No se pudo crear: ${err.message}`); }
