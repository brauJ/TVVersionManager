import { useEffect, useMemo, useState } from 'react';
import { Activity, BadgeCheck, CalendarClock, Download, Fingerprint, LayoutDashboard, LogIn, LogOut, Search, ShieldCheck, Users, Clock3, RefreshCw } from 'lucide-react';

const API = '/api';
type Employee = { id:string; rut:string; firstName:string; lastName:string; position?:string|null; status:string };
type RecordRow = {
  id:string; type:string; method:string; occurredAt:string;
  employee:Employee; status:string; manualReason?:string|null;
  creator?:{id:string;fullName:string;email:string}|null;
  auditTrail?:{
    action:string; reason?:string|null; createdAt:string;
    user?:{id:string;fullName:string;email:string}|null;
  }[];
};
type UserRow = { id:string; email:string; fullName:string; status:'ACTIVE'|'DISABLED'; isSuperAdmin:boolean; createdAt:string; permissions:{code:string;description:string}[] };
type PermissionRow = { id:string; code:string; description:string };
type Department = { id:string; name:string; active:boolean; _count?:{employees:number} };
type Branch = { id:string; name:string; address?:string|null; active:boolean; _count?:{employees:number} };
type Shift = {
  id:string; name:string; startTime:string; endTime:string;
  breakStart?:string|null; breakEnd?:string|null;
  toleranceMinutes:number; mode:'TWO_PUNCH'|'FOUR_PUNCH';
  crossesMidnight:boolean; active:boolean;
  assignments?:{
    id:string; validFrom:string; validTo?:string|null;
    employee:{id:string;rut:string;firstName:string;lastName:string;status:string}
  }[];
};
const fmt = (d:string) => new Date(d).toLocaleString('es-CL', { dateStyle:'short', timeStyle:'medium' });

export default function App() {
  const [token,setToken] = useState(localStorage.getItem('attendance_token') || '');
  const [email,setEmail] = useState('');
  const [password,setPassword] = useState('');
  const [error,setError] = useState('');
  const [tab,setTab] = useState<'overview'|'employees'|'attendance'|'users'|'organization'|'shifts'>('overview');
  const [employees,setEmployees] = useState<Employee[]>([]);
  const [records,setRecords] = useState<RecordRow[]>([]);
  const [users,setUsers] = useState<UserRow[]>([]);
  const [permissionCatalog,setPermissionCatalog] = useState<PermissionRow[]>([]);
  const [editingPermissionsUser,setEditingPermissionsUser] = useState<UserRow|null>(null);
  const [editingUser,setEditingUser] = useState<UserRow|null>(null);
  const [userEditForm,setUserEditForm] = useState({fullName:'',email:'',password:'',confirmPassword:''});
  const [selectedPermissionCodes,setSelectedPermissionCodes] = useState<string[]>([]);
  const [departments,setDepartments] = useState<Department[]>([]);
  const [branches,setBranches] = useState<Branch[]>([]);
  const [shifts,setShifts] = useState<Shift[]>([]);
  const [organizationBusy,setOrganizationBusy] = useState(false);
  const [shiftBusy,setShiftBusy] = useState(false);
  const [departmentName,setDepartmentName] = useState('');
  const [branchForm,setBranchForm] = useState({name:'',address:''});
  const [shiftForm,setShiftForm] = useState({
    name:'',startTime:'09:00',endTime:'18:00',
    breakStart:'13:00',breakEnd:'14:00',
    toleranceMinutes:'5',mode:'FOUR_PUNCH' as 'TWO_PUNCH'|'FOUR_PUNCH',
    crossesMidnight:false
  });
  const [assignmentForm,setAssignmentForm] = useState({
    shiftId:'',employeeId:'',validFrom:'',validTo:''
  });
  const [userActionBusy,setUserActionBusy] = useState('');
  const [query,setQuery] = useState('');
  const [busy,setBusy] = useState(false);
  const [employeeForm,setEmployeeForm] = useState({rut:'',firstName:'',lastName:'',position:''});
  const [editingEmployee,setEditingEmployee] = useState<Employee | null>(null);
  const [employeeStatusFilter,setEmployeeStatusFilter] = useState('ALL');
  const [notice,setNotice] = useState('');
  const [attendanceFrom,setAttendanceFrom] = useState('');
  const [attendanceTo,setAttendanceTo] = useState('');
  const [attendanceStatus,setAttendanceStatus] = useState('ALL');
  const [attendanceEmployee,setAttendanceEmployee] = useState('ALL');
  const [reviewBusy,setReviewBusy] = useState('');

  async function api(path:string, init:RequestInit={}) {
    const res = await fetch(`${API}${path}`, { ...init, headers: { 'Content-Type':'application/json', ...(token ? { Authorization:`Bearer ${token}` } : {}), ...(init.headers || {}) } });
    if (!res.ok) throw new Error((await res.text()).slice(0,300) || `HTTP ${res.status}`);
    return res.json();
  }
  async function login(e:React.FormEvent) {
    e.preventDefault(); setError('');
    try {
      const data = await api('/auth/login',{method:'POST',body:JSON.stringify({email,password})});
      localStorage.setItem('attendance_token',data.accessToken); setToken(data.accessToken);
    } catch { setError('No se pudo iniciar sesión. Verifica las credenciales y que la API esté disponible.'); }
  }
  async function load() {
    if (!token) return;
    setBusy(true); setError('');
    try {
      const employeeParams = new URLSearchParams({ q: query });
      if (employeeStatusFilter !== 'ALL') employeeParams.set('status', employeeStatusFilter);
      const [e,r] = await Promise.all([api(`/employees?${employeeParams.toString()}`),api('/attendance')]);
      setEmployees(e); setRecords(r);
    } catch (err:any) { setError(`No se pudieron cargar los datos. ${err.message || ''}`); }
    finally { setBusy(false); }
  }
  async function loadUsers() {
    if (!token) return;
    setError('');
    try {
      const [data, catalog] = await Promise.all([
        api('/users'),
        api('/users/permissions')
      ]);
      setUsers(data);
      setPermissionCatalog(catalog);
    } catch (err:any) {
      setError(`No se pudieron cargar los usuarios. ${err.message || ''}`);
    }
  }

  function beginEditUser(user:UserRow) {
    setEditingUser(user);
    setUserEditForm({
      fullName:user.fullName,
      email:user.email,
      password:'',
      confirmPassword:''
    });
    setEditingPermissionsUser(null);
    setError('');
    setNotice('');
  }

  async function saveUserEdit(e:React.FormEvent) {
    e.preventDefault();
    const user = editingUser;
    if (!user) return;

    const fullName = userEditForm.fullName.trim();
    const email = userEditForm.email.trim();

    if (fullName.length < 2) {
      setError('El nombre debe tener al menos 2 caracteres.');
      return;
    }
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      setError('Ingresa un correo electrónico válido.');
      return;
    }
    if (userEditForm.password || userEditForm.confirmPassword) {
      if (userEditForm.password.length < 12) {
        setError('La nueva contraseña debe tener al menos 12 caracteres.');
        return;
      }
      if (userEditForm.password !== userEditForm.confirmPassword) {
        setError('La nueva contraseña y su confirmación no coinciden.');
        return;
      }
    }

    if (!window.confirm(`¿Guardar los cambios de la cuenta ${user.email}?`)) return;

    const payload:{fullName:string;email:string;password?:string} = {fullName,email};
    if (userEditForm.password) payload.password = userEditForm.password;

    setUserActionBusy(user.id);
    setError('');
    setNotice('');

    try {
      await api(`/users/${encodeURIComponent(user.id)}`, {
        method:'PATCH',
        body:JSON.stringify(payload)
      });
      setNotice(
        userEditForm.password
          ? `Datos y contraseña actualizados para ${email}.`
          : `Datos actualizados para ${email}. La contraseña no se modificó.`
      );
      setEditingUser(null);
      setUserEditForm({fullName:'',email:'',password:'',confirmPassword:''});
      await loadUsers();
    } catch (err:any) {
      setError(`No se pudo actualizar el usuario. ${err.message || ''}`);
    } finally {
      setUserActionBusy('');
    }
  }

  function beginEditUserPermissions(user:UserRow) {
    if (user.isSuperAdmin) return;
    setEditingPermissionsUser(user);
    setSelectedPermissionCodes(user.permissions.map(permission => permission.code));
    setError('');
    setNotice('');
  }

  async function saveUserPermissions() {
    const user = editingPermissionsUser;
    if (!user) return;

    if (!window.confirm(`¿Guardar los permisos seleccionados para ${user.fullName}?`)) return;

    setUserActionBusy(user.id);
    setError('');
    setNotice('');

    try {
      await api(`/users/${encodeURIComponent(user.id)}/permissions`, {
        method:'PATCH',
        body:JSON.stringify({permissionCodes:selectedPermissionCodes})
      });
      setNotice(`Permisos actualizados para ${user.email}. Si tenía una sesión abierta, debe cerrar sesión y volver a entrar.`);
      setEditingPermissionsUser(null);
      await loadUsers();
    } catch (err:any) {
      setError(`No se pudieron guardar los permisos. ${err.message || ''}`);
    } finally {
      setUserActionBusy('');
    }
  }

  async function toggleUserStatus(user:UserRow) {
    const activating = user.status === 'DISABLED';
    const nextStatus = activating ? 'ACTIVE' : 'DISABLED';
    const action = activating ? 'activar' : 'desactivar';

    if (!window.confirm(`¿Seguro que deseas ${action} la cuenta de ${user.fullName} (${user.email})?`)) return;

    setUserActionBusy(user.id);
    setError('');
    setNotice('');

    try {
      await api(`/users/${encodeURIComponent(user.id)}/status`, {
        method:'PATCH',
        body:JSON.stringify({status:nextStatus})
      });
      setNotice(`Cuenta ${activating ? 'activada' : 'desactivada'} correctamente: ${user.email}`);
      await loadUsers();
    } catch (err:any) {
      setError(`No se pudo cambiar el estado de la cuenta. ${err.message || ''}`);
    } finally {
      setUserActionBusy('');
    }
  }

  async function loadOrganization() {
    if (!token) return;
    setOrganizationBusy(true);
    try {
      const [d,b] = await Promise.all([
        api('/departments'),
        api('/branches')
      ]);
      setDepartments(d);
      setBranches(b);
    } catch (err:any) {
      setError(`No se pudo cargar la organización. ${err.message || ''}`);
    } finally {
      setOrganizationBusy(false);
    }
  }

  async function loadShifts() {
    if (!token) return;
    setShiftBusy(true);
    try {
      const [s,e] = await Promise.all([
        api('/shifts'),
        api('/employees?status=ACTIVE')
      ]);
      setShifts(s);
      setEmployees(e);
      setAssignmentForm(old => ({
        ...old,
        shiftId: old.shiftId || (s[0]?.id ?? ''),
        employeeId: old.employeeId || (e[0]?.id ?? '')
      }));
    } catch (err:any) {
      setError(`No se pudieron cargar los turnos. ${err.message || ''}`);
    } finally {
      setShiftBusy(false);
    }
  }

  async function createDepartment(e:React.FormEvent) {
    e.preventDefault();
    setNotice('');
    setError('');
    try {
      await api('/departments', {
        method:'POST',
        body:JSON.stringify({name:departmentName.trim()})
      });
      setDepartmentName('');
      setNotice('Departamento creado correctamente.');
      await loadOrganization();
    } catch (err:any) {
      setError(`No se pudo crear el departamento. ${err.message || ''}`);
    }
  }

  async function createBranch(e:React.FormEvent) {
    e.preventDefault();
    setNotice('');
    setError('');
    try {
      await api('/branches', {
        method:'POST',
        body:JSON.stringify({
          name:branchForm.name.trim(),
          address:branchForm.address.trim() || undefined
        })
      });
      setBranchForm({name:'',address:''});
      setNotice('Sucursal creada correctamente.');
      await loadOrganization();
    } catch (err:any) {
      setError(`No se pudo crear la sucursal. ${err.message || ''}`);
    }
  }

  async function editDepartment(d:Department) {
    const name = window.prompt('Nombre del departamento:', d.name);
    if (name === null) return;
    if (name.trim().length < 2) {
      setError('El nombre del departamento debe tener al menos 2 caracteres.');
      return;
    }
    setError('');
    setNotice('');
    try {
      await api(`/departments/${encodeURIComponent(d.id)}`, {
        method:'PATCH',
        body:JSON.stringify({name:name.trim()})
      });
      setNotice('Departamento actualizado.');
      await loadOrganization();
    } catch (err:any) {
      setError(`No se pudo actualizar el departamento. ${err.message || ''}`);
