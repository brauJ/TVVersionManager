import { useEffect, useMemo, useState } from 'react';
import { Activity, BadgeCheck, CalendarClock, Download, Fingerprint, LayoutDashboard, LogIn, LogOut, Search, ShieldCheck, Users, Clock3, RefreshCw } from 'lucide-react';

const API = '/api';
type Employee = { id:string; rut:string; firstName:string; lastName:string; position?:string|null; status:string };
type RecordRow = { id:string; type:string; method:string; occurredAt:string; employee:Employee; status:string };
const fmt = (d:string) => new Date(d).toLocaleString('es-CL', { dateStyle:'short', timeStyle:'medium' });

export default function App() {
  const [token,setToken] = useState(localStorage.getItem('attendance_token') || '');
  const [email,setEmail] = useState('');
  const [password,setPassword] = useState('');
  const [error,setError] = useState('');
  const [tab,setTab] = useState<'overview'|'employees'|'attendance'>('overview');
  const [employees,setEmployees] = useState<Employee[]>([]);
  const [records,setRecords] = useState<RecordRow[]>([]);
  const [query,setQuery] = useState('');
  const [busy,setBusy] = useState(false);
  const [employeeForm,setEmployeeForm] = useState({rut:'',firstName:'',lastName:'',position:''});
  const [notice,setNotice] = useState('');

  async function api(path:string, init:RequestInit={}) {
    const res = await fetch(`${API}${path}`, { ...init, headers: { 'Content-Type':'application/json', ...(token ? { Authorization:`Bearer ${token}` } : {}), ...(init.headers || {}) } });
    if (!res.ok) throw new Error((await res.text()).slice(0,300) || `HTTP ${res.status}`);
    return res.json();
  }
  async function login(e:React.FormEvent) {
    e.preventDefault(); setError('');
    try {
      const data = await api('/auth/login',{method:'POST',body:JSON.stringify({email,password})});
      localStorage.setItem('attendance_token',data.accessToken); setToken(data.accessToken);
    } catch { setError('No se pudo iniciar sesión. Verifica las credenciales y que la API esté disponible.'); }
  }
  async function load() {
    if (!token) return;
    setBusy(true); setError('');
    try {
      const [e,r] = await Promise.all([api(`/employees?q=${encodeURIComponent(query)}`),api('/attendance')]);
      setEmployees(e); setRecords(r);
    } catch (err:any) { setError(`No se pudieron cargar los datos. ${err.message || ''}`); }
    finally { setBusy(false); }
  }
  useEffect(()=>{ if(token) void load(); },[token,tab]);
  const todayCount = useMemo(()=>records.filter(r=>new Date(r.occurredAt).toDateString()===new Date().toDateString()).length,[records]);
  async function createEmployee(e:React.FormEvent) {
    e.preventDefault(); setNotice('');
    try {
      await api('/employees',{method:'POST',body:JSON.stringify(employeeForm)});
      setEmployeeForm({rut:'',firstName:'',lastName:'',position:''}); setNotice('Trabajador creado.'); await load();
    } catch(err:any) { setNotice(`No se pudo crear: ${err.message}`); }
  }
  function logout() { localStorage.removeItem('attendance_token'); setToken(''); setEmployees([]); setRecords([]); }

  if (!token) return <main className="login-shell"><section className="login-card"><div className="brand-mark"><Fingerprint size={28}/></div><p className="eyebrow">CONTROL LABORAL</p><h1>Asistencia</h1><p className="muted">Acceso al panel administrativo</p><form onSubmit={login} className="stack"><label>Correo electrónico<input type="email" value={email} onChange={e=>setEmail(e.target.value)} required autoComplete="username"/></label><label>Contraseña<input type="password" value={password} onChange={e=>setPassword(e.target.value)} required minLength={12} autoComplete="current-password"/></label>{error&&<p className="error">{error}</p>}<button className="primary"><LogIn size={17}/> Iniciar sesión</button></form><p className="footnote">Conecta la API y configura tu administrador mediante el seed de Prisma.</p></section></main>;

  return <div className="app-shell">
    <aside className="sidebar"><div className="brand"><div className="brand-mark"><Fingerprint size={23}/></div><div><strong>Asistencia</strong><small>GESTIÓN LABORAL</small></div></div><div className="nav-label">MENÚ PRINCIPAL</div>
      <button className={tab==='overview'?'nav active':'nav'} onClick={()=>setTab('overview')}><LayoutDashboard size={18}/> Resumen</button>
      <button className={tab==='employees'?'nav active':'nav'} onClick={()=>setTab('employees')}><Users size={18}/> Trabajadores</button>
      <button className={tab==='attendance'?'nav active':'nav'} onClick={()=>setTab('attendance')}><CalendarClock size={18}/> Marcaciones</button>
      <div className="sidebar-bottom"><div className="secure-note"><ShieldCheck size={18}/><span><b>Panel protegido</b><small>Revisa los permisos del servidor antes de producción.</small></span></div><button className="nav" onClick={logout}><LogOut size={18}/> Cerrar sesión</button></div>
    </aside>
    <main className="main">
      <header className="topbar"><div><p className="eyebrow">SISTEMA DE ASISTENCIA</p><h1>{tab==='overview'?'Resumen general':tab==='employees'?'Trabajadores':'Marcaciones'}</h1></div><div className="top-actions"><span className="server-pill"><span className="dot"/> API conectada</span><button className="icon-button" onClick={()=>void load()} title="Actualizar"><RefreshCw size={17}/></button></div></header>
      {error&&<div className="alert error">{error}</div>}{notice&&<div className="alert">{notice}</div>}
      {tab==='overview'&&<><section className="welcome"><div><p className="eyebrow light">PANEL DE CONTROL</p><h2>Todo en orden, a primera vista.</h2><p>Consulta la actividad de asistencia y administra la información de tu equipo.</p></div><div className="welcome-icon"><Activity size={38}/></div></section>
        <section className="stat-grid"><Stat icon={<Users/>} label="Trabajadores cargados" value={String(employees.length)} hint="Registros disponibles"/><Stat icon={<Clock3/>} label="Marcaciones de hoy" value={String(todayCount)} hint="Según hora local del navegador"/><Stat icon={<BadgeCheck/>} label="Últimos registros" value={String(records.length)} hint="Máximo 1.000 registros consultados"/></section>
        <section className="panel"><div className="panel-head"><div><h3>Marcaciones recientes</h3><p>Eventos recibidos desde la base de datos</p></div><button className="secondary" onClick={()=>setTab('attendance')}>Ver marcaciones</button></div><Records rows={records.slice(0,8)}/></section></>}
      {tab==='employees'&&<><section className="panel"><div className="panel-head"><div><h3>Directorio de trabajadores</h3><p>Consulta trabajadores guardados en MySQL</p></div><form className="search" onSubmit={e=>{e.preventDefault();void load();}}><Search size={17}/><input placeholder="Buscar nombre o RUT" value={query} onChange={e=>setQuery(e.target.value)}/><button className="secondary">Buscar</button></form></div><div className="table-wrap"><table><thead><tr><th>Trabajador</th><th>RUT</th><th>Cargo</th><th>Estado</th></tr></thead><tbody>{employees.map(e=><tr key={e.id}><td><b>{e.firstName} {e.lastName}</b></td><td>{e.rut}</td><td>{e.position||'—'}</td><td><span className="status">{e.status==='ACTIVE'?'Activo':'Inactivo'}</span></td></tr>)}</tbody></table>{!employees.length&&<div className="empty">No hay trabajadores para mostrar.</div>}</div></section>
        <section className="panel"><div className="panel-head"><div><h3>Agregar trabajador</h3><p>Los datos se guardarán en la base de datos</p></div></div><form className="employee-form" onSubmit={createEmployee}><label>RUT<input value={employeeForm.rut} onChange={e=>setEmployeeForm({...employeeForm,rut:e.target.value})} required minLength={3}/></label><label>Nombre<input value={employeeForm.firstName} onChange={e=>setEmployeeForm({...employeeForm,firstName:e.target.value})} required/></label><label>Apellidos<input value={employeeForm.lastName} onChange={e=>setEmployeeForm({...employeeForm,lastName:e.target.value})} required/></label><label>Cargo<input value={employeeForm.position} onChange={e=>setEmployeeForm({...employeeForm,position:e.target.value})}/></label><button className="primary">Guardar trabajador</button></form></section></>}
      {tab==='attendance'&&<section className="panel"><div className="panel-head"><div><h3>Historial de marcaciones</h3><p>Registros almacenados en MySQL</p></div><button className="secondary" onClick={()=>downloadCsv(records)}><Download size={16}/> Exportar CSV</button></div><Records rows={records}/></section>}
      <footer>Asistencia · Base de desarrollo · Requiere revisión de seguridad y normativa antes de uso oficial.</footer>
    </main>
  </div>;
}
function Stat({icon,label,value,hint}:{icon:React.ReactNode,label:string,value:string,hint:string}) { return <div className="stat"><div className="stat-top"><span className="stat-icon">{icon}</span><span className="stat-hint">{hint}</span></div><p>{label}</p><strong>{value}</strong></div>; }
function Records({rows}:{rows:RecordRow[]}) { const labels:any={ENTRY:'Entrada',BREAK_START:'Salida a colación',BREAK_END:'Regreso de colación',EXIT:'Salida final'}; const methods:any={FINGERPRINT:'Huella',PIN:'PIN',ADMIN_MANUAL:'Manual'}; return <div className="table-wrap"><table><thead><tr><th>Trabajador</th><th>Tipo</th><th>Fecha y hora</th><th>Método</th><th>Estado</th></tr></thead><tbody>{rows.map(r=><tr key={r.id}><td><b>{r.employee?.firstName} {r.employee?.lastName}</b><small className="subcell">{r.employee?.rut}</small></td><td>{labels[r.type]||r.type}</td><td>{fmt(r.occurredAt)}</td><td>{methods[r.method]||r.method}</td><td><span className="status">{r.status==='CONFIRMED'?'Confirmada':r.status}</span></td></tr>)}</tbody></table>{!rows.length&&<div className="empty">No hay marcaciones para mostrar.</div>}</div>; }
function downloadCsv(rows:RecordRow[]) { const lines=[['Trabajador','RUT','Tipo','Fecha','Método','Estado'],...rows.map(r=>[`${r.employee?.firstName||''} ${r.employee?.lastName||''}`,r.employee?.rut||'',r.type,r.occurredAt,r.method,r.status])]; const csv=lines.map(line=>line.map(x=>`"${String(x).replaceAll('"','""')}"`).join(';')).join('\r\n'); const url=URL.createObjectURL(new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8;'})); const a=document.createElement('a'); a.href=url; a.download='marcaciones.csv'; a.click(); URL.revokeObjectURL(url); }
