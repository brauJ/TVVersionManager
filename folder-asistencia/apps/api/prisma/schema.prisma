
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceType {
  ENTRY
  BREAK_START
  BREAK_END
  EXIT
}

enum AttendanceMethod {
  FINGERPRINT
  PIN
  ADMIN_MANUAL
}

enum AttendanceStatus {
  CONFIRMED
  PENDING_REVIEW
  VOIDED
}

enum ShiftMode {
  TWO_PUNCH
  FOUR_PUNCH
}

enum OvertimeAuthorizationStatus {
  ACTIVE
  CANCELLED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique @db.VarChar(190)
  passwordHash String     @db.VarChar(255)
  fullName     String     @db.VarChar(190)
  status       UserStatus @default(ACTIVE)
  isSuperAdmin Boolean    @default(false)
  permissions  UserPermission[]
  auditLogs    AuditLog[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  overtimeAuthorizations OvertimeAuthorization[] @relation("OvertimeAuthorizedBy")
overtimeCancellations  OvertimeAuthorization[] @relation("OvertimeCancelledBy")
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique @db.VarChar(100)
  description String           @db.VarChar(255)
  users       UserPermission[]
}

model UserPermission {
  userId       String
  permissionId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

model Department {
  id        String     @id @default(cuid())
  name      String     @unique @db.VarChar(120)
  active    Boolean    @default(true)
  employees Employee[]
}

model Branch {
  id        String     @id @default(cuid())
  name      String     @unique @db.VarChar(120)
  address   String?    @db.VarChar(255)
  active    Boolean    @default(true)
  employees Employee[]
}

model Employee {
  id                    String                 @id @default(cuid())
  rut                   String                 @unique @db.VarChar(20)
  firstName             String                 @db.VarChar(100)
  lastName              String                 @db.VarChar(100)
  position              String?                @db.VarChar(120)
  departmentId          String?
  branchId              String?
  hiredAt               DateTime?
  status                EmployeeStatus          @default(ACTIVE)
  department             Department?             @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  branch                 Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull)
  shiftAssignments       ShiftAssignment[]
  sessions               WorkSession[]
  attendance             AttendanceRecord[]
  biometricCredentials   BiometricCredential[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  overtimeAuthorizations OvertimeAuthorization[]

  @@index([lastName, firstName])
  @@index([status])
}

model Shift {
  id               String            @id @default(cuid())
  name             String            @unique @db.VarChar(120)
  startTime        String            @db.VarChar(5)
  endTime          String            @db.VarChar(5)
  breakStart       String?           @db.VarChar(5)
  breakEnd         String?           @db.VarChar(5)
  toleranceMinutes Int               @default(0)
  mode             ShiftMode         @default(FOUR_PUNCH)
  crossesMidnight  Boolean           @default(false)
  active           Boolean           @default(true)
  assignments      ShiftAssignment[]
  createdAt        DateTime          @default(now())
}

model ShiftAssignment {
  id         String   @id @default(cuid())
  employeeId String
  shiftId    String
  validFrom  DateTime
  validTo    DateTime?
  employee   Employee @relation(fields: [employeeId], references: [id])
  shift      Shift    @relation(fields: [shiftId], references: [id])

  @@index([employeeId, validFrom, validTo])
}

model WorkSession {
  id         String             @id @default(cuid())
  employeeId String
  workDate   DateTime           @db.Date
  shiftId    String?
  employee   Employee           @relation(fields: [employeeId], references: [id])
  records    AttendanceRecord[]
  createdAt  DateTime           @default(now())

  @@unique([employeeId, workDate])
}

model AttendanceRecord {
  id              String                  @id @default(cuid())
  eventId         String                  @unique @db.VarChar(190)
  employeeId      String
  sessionId       String?
  type            AttendanceType
  method          AttendanceMethod
  status          AttendanceStatus         @default(CONFIRMED)
  occurredAt      DateTime
  receivedAt      DateTime                @default(now())
  deviceId        String?                 @db.VarChar(190)
  manualReason    String?                 @db.Text
  createdByUserId String?
  employee        Employee                @relation(fields: [employeeId], references: [id])
  session         WorkSession?            @relation(fields: [sessionId], references: [id])
  manualChange    ManualAttendanceChange?
  createdAt       DateTime                @default(now())

  @@index([employeeId, occurredAt])
  @@index([sessionId, type])
}

model ManualAttendanceChange {
  id                String           @id @default(cuid())
  attendanceRecordId String          @unique
  action             String          @db.VarChar(30)
  reason             String          @db.Text
  adminUserId        String
  beforeJson         Json?
  afterJson          Json?
  record             AttendanceRecord @relation(fields: [attendanceRecordId], references: [id])
  createdAt          DateTime         @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(100)
  entityId   String?  @db.VarChar(190)
  beforeJson Json?
  afterJson  Json?
  reason     String?  @db.Text
  requestId  String?  @db.VarChar(190)
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
}

model BiometricCredential {
  id               String   @id @default(cuid())
  employeeId       String
  deviceTemplateId String   @unique @db.VarChar(190)
  active           Boolean  @default(true)
  enrolledBy       String
  enrolledAt       DateTime @default(now())
  revokedAt        DateTime?
  employee         Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, active])
}

model BiometricDevice {
  id            String        @id @default(cuid())
  name          String        @db.VarChar(120)
  deviceKeyHash String        @db.VarChar(255)
  active        Boolean       @default(true)
  lastSeenAt    DateTime?
  events        DeviceEvent[]
  createdAt     DateTime      @default(now())
}

model DeviceEvent {
  id         String          @id @default(cuid())
  eventId    String          @unique @db.VarChar(190)
  deviceId   String
  receivedAt DateTime        @default(now())
  result     String          @db.VarChar(40)
  details    String?         @db.VarChar(255)
  device     BiometricDevice @relation(fields: [deviceId], references: [id])

  @@index([deviceId, receivedAt])
}

model AlternativeMethodAuthorization {
  id         String   @id @default(cuid())
  employeeId String
  method     String   @db.VarChar(40)
  reason     String   @db.Text
  approvedBy String
  validFrom  DateTime
  validUntil DateTime?
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([employeeId, validFrom, validUntil])
}

model CompanySettings {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt
}

model LoginSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model ReportExport {
  id         String   @id @default(cuid())
  userId     String
  reportType String   @db.VarChar(80)
  filtersJson Json
  createdAt  DateTime @default(now())
}

model DataRetentionPolicy {
  id            String   @id @default(cuid())
  recordType    String   @unique @db.VarChar(100)
  retentionDays Int
  legalBasis    String   @db.Text
  updatedAt     DateTime @updatedAt
}

model OvertimeAuthorization {
  id                  String                       @id @default(cuid())
  employeeId          String
  authorizedByUserId  String
  cancelledByUserId   String?
  workDate            DateTime                     @db.Date
  startAt             DateTime
  endAt               DateTime
  reason              String                       @db.Text
  status              OvertimeAuthorizationStatus  @default(ACTIVE)
  cancelledAt         DateTime?
  cancellationReason  String?                      @db.Text
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  authorizedBy User     @relation("OvertimeAuthorizedBy", fields: [authorizedByUserId], references: [id], onDelete: Restrict)
  cancelledBy  User?    @relation("OvertimeCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)

  @@index([employeeId, workDate])
  @@index([status, startAt, endAt])
  @@index([authorizedByUserId, createdAt])
}
